<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Runtime-created WinForms controls expose stateful properties that are not designer content. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MainForm.cs" />
    <Compile Remove="MapCanvas.cs" />
    <Compile Remove="MapCanvasV2.cs" />
    <Compile Remove="Map3DPreview.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UzDoomMapEditor.Core\UzDoomMapEditor.Core.csproj" />
    <ProjectReference Include="..\UzDoom.Core\UzDoom.Core.csproj" />
  </ItemGroup>
</Project>
