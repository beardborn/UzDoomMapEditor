<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- MapCanvas is created and configured entirely in code. Its Project/Tool
         properties are runtime-only editor state, not WinForms designer content. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MapCanvas.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UzDoomMapEditor.Core\UzDoomMapEditor.Core.csproj" />
    <ProjectReference Include="..\UzDoom.Core\UzDoom.Core.csproj" />
  </ItemGroup>
</Project>
